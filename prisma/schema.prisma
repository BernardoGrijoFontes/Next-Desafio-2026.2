// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Produto {
  id          Int      @id @default(autoincrement())
  nome        String
  foto_um     String
  foto_dois   String
  descricao   String
  preco       Float
  tamanho     String
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
}